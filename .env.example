# Copy this file to backend/.env and fill in your own keys.
# Nothing in this repo will run without them — no keys are bundled.

# Speech-to-text — https://console.deepgram.com (free trial credit available)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
# "multi" enables code-switching detection (e.g. French/English mid-call)
DEEPGRAM_LANGUAGE=multi

# Text-to-speech — https://elevenlabs.io (free tier available)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Must be a multilingual model for non-English output to sound natural
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# LLM — pick one provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Turn-taking tuning
END_OF_UTTERANCE_SILENCE_MS=700

# Business context spoken by the agent
BUSINESS_NAME=Aurora Boutique

# Telephony — the carrier is just configuration, swap it without touching code.
# "telnyx" is the only value implemented so far.
TELEPHONY_PROVIDER=telnyx
TELEPHONY_API_KEY=
# Public https URL this server is reachable at (a real deploy, or an ngrok
# tunnel while testing locally — the carrier can't reach "localhost").
TELEPHONY_PUBLIC_URL=

CALL_LOG_DB_PATH=voxbridge_calls.db
